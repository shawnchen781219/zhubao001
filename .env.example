# App
NODE_ENV=development
APP_PORT=3000
API_BASE_URL=http://localhost:3000

# Database
# Prisma 7 reads this through prisma.config.ts; schema.prisma keeps provider only.
DATABASE_URL=postgresql://jewelry:jewelry@localhost:5432/jewelry_digital?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Storage adapter placeholder
STORAGE_PROVIDER=local
STORAGE_BUCKET=jewelry-digital-dev

# AI gateway placeholder
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=

# WeChat placeholder
WECHAT_APP_ID=
WECHAT_APP_SECRET=
