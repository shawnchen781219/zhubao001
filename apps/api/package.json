{
	"name": "@jewelry/api",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Offline NestJS API boundary skeleton for the jewelry digital system.",
	"dependencies": {
		"@jewelry/shared": "workspace:*",
		"@nestjs/common": "11.1.24",
		"@nestjs/core": "11.1.24",
		"@nestjs/platform-fastify": "11.1.24",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "7.8.0",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"fastify": "5.8.5",
		"pg": "^8.21.0",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"zod": "4.4.3"
	},
	"scripts": {
		"build": "tsc --project tsconfig.json",
		"start": "node dist/main.js",
		"typecheck": "tsc --project tsconfig.json --noEmit",
		"lint": "echo 'lint placeholder: install lint dependencies before enabling @jewelry/api lint'",
		"test": "vitest run --exclude 'dist/**'",
		"prisma:validate": "prisma validate --config ../../prisma.config.ts",
		"prisma:generate": "prisma generate --config ../../prisma.config.ts"
	},
	"devDependencies": {
		"prisma": "7.8.0",
		"tsx": "^4.22.4",
		"vitest": "4.1.7"
	}
}
