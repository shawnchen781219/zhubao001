{
	"name": "jewelry-digital-system",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@10.34.1",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "turbo typecheck && biome check .",
		"deploy": "./scripts/deploy.sh all",
		"deploy:api": "./scripts/deploy.sh api",
		"deploy:h5": "./scripts/deploy.sh h5",
		"deploy:admin": "./scripts/deploy.sh admin",
		"deploy:prisma": "./scripts/deploy.sh prisma",
		"deploy:quick": "./scripts/deploy.sh api --skip-build --skip-commit"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.16",
		"turbo": "2.9.16",
		"typescript": "6.0.3"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.8.0",
		"@types/pg": "^8.20.0",
		"pg": "^8.21.0"
	}
}
